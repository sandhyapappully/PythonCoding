# =====================================================
# BEST STUDENT
# =====================================================

def best_student():

    c.execute("""
    SELECT
        studentgrade.student_id,
        studentgrade.user_name,
        marks.Physics,
        marks.Chemistry,
        marks.Mathematics,
        marks.English
    FROM studentgrade
    INNER JOIN marks
    ON studentgrade.student_id = marks.student_id
    """)

    students = c.fetchall()

    print("\n===================================")
    print("           BEST STUDENT")
    print("===================================")

    if not students:

        print("No marks available.")
        return

    best_total = -1

    best_students = []

    for student in students:

        total = (
            student[2] +
            student[3] +
            student[4] +
            student[5]
        )

        average = total / 4

        if total > best_total:

            best_total = total

            best_students = [
                (
                    student[0],
                    student[1],
                    total,
                    average
                )
            ]

        elif total == best_total:

            best_students.append(
                (
                    student[0],
                    student[1],
                    total,
                    average
                )
            )

    for student in best_students:

        print("Student ID :", student[0])
        print("Username   :", student[1])
        print("Total Marks:", student[2])
        print("Average    :", round(student[3], 2))
        print("Grade      :", get_grade(student[3]))
        print("-----------------------------------")

    print("Best Student displayed successfully!")


# =====================================================
# SUBJECT TOPPERS
# =====================================================

def subject_toppers():

    subjects = [
        ("Physics", 2),
        ("Chemistry", 3),
        ("Mathematics", 4),
        ("English", 5)
    ]

    print("\n===================================")
    print("          SUBJECT TOPPERS")
    print("===================================")

    for subject, column in subjects:

        query = f"""
        SELECT
            studentgrade.student_id,
            studentgrade.user_name,
            marks.{subject}
        FROM studentgrade
        INNER JOIN marks
        ON studentgrade.student_id = marks.student_id
        WHERE marks.{subject} = (
            SELECT MAX({subject})
            FROM marks
        )
        """

        c.execute(query)

        toppers = c.fetchall()

        print("\n-----------------------------------")
        print(subject.upper() + " TOPPER")
        print("-----------------------------------")

        if toppers:

            for topper in toppers:

                print(
                    "Student ID :",
                    topper[0]
                )

                print(
                    "Username   :",
                    topper[1]
                )

                print(
                    subject + " Marks :",
                    topper[2]
                )

        else:

            print("No marks available.")


